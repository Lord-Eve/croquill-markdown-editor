{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Croquill",
  "version": "0.6.0",
  "identifier": "io.github.lord-eve.croquill",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "未命名 — Croquill",
      "width": 1200,
      "height": 850,
      "minWidth": 760,
      "minHeight": 540,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lord-Eve",
    "homepage": "https://github.com/Lord-Eve/croquill-markdown-editor",
    "copyright": "Copyright (c) 2026 Lord-Eve",
    "license": "MIT",
    "shortDescription": "本地 Markdown 写作编辑器",
    "icon": ["icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Croquill.Markdown",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
